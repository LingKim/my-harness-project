# MySQL 本地开发配置
MYSQL_DATABASE=heness
MYSQL_USER=heness
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306

# Spring Boot 后端配置
BACKEND_PORT=8080
SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/heness?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false"
SPRING_DATASOURCE_USERNAME=heness
SPRING_DATASOURCE_PASSWORD=replace-with-local-app-password
DATABASE_ENABLED=true
FRONTEND_ORIGIN=http://localhost:3000

# OpenAI-compatible 配置：默认关闭，不会发起模型调用
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Next.js 前端配置：只有 NEXT_PUBLIC_ 前缀变量会进入浏览器
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
