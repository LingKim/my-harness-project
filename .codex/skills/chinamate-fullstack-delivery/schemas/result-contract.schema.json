{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinamate.local/schemas/handoff/result-contract.schema.json",
  "title": "ResultContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "change", "stage", "role", "taskIds", "requestFingerprint", "status", "modifiedFiles", "outputReferences", "verificationSummary", "deviations", "blockers", "notRun", "residualRisks", "recommendations", "acceptance", "persistedBy"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "contractId": {"type": "string", "minLength": 1},
    "change": {"type": "string", "minLength": 1},
    "stage": {"enum": ["PRODUCT_SPEC", "INTERACTION_DESIGN", "FRONTEND_IMPLEMENTATION", "BACKEND_IMPLEMENTATION", "QA", "SPEC_REVIEW", "EXPERIENCE_REVIEW", "CONTROL_PLANE_IMPLEMENTATION"]},
    "role": {"enum": ["product_manager", "interaction_designer", "frontend_engineer", "backend_engineer", "qa_engineer", "spec_reviewer", "experience_reviewer", "main_agent"]},
    "taskIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requestFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "PASS_WITH_ISSUES", "FAIL", "BLOCKED", "NOT_RUN"]},
    "modifiedFiles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "outputReferences": {"type": "array", "items": {"type": "string"}},
    "verificationSummary": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/verification"}},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "notRun": {"type": "array", "items": {"type": "string"}},
    "residualRisks": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"$ref": "common.schema.json#/$defs/acceptance"},
    "persistedBy": {"const": "main_agent"}
  },
  "oneOf": [
    {
      "properties": {
        "stage": {"const": "CONTROL_PLANE_IMPLEMENTATION"},
        "role": {"const": "main_agent"}
      }
    },
    {
      "properties": {
        "stage": {"enum": ["PRODUCT_SPEC", "INTERACTION_DESIGN", "FRONTEND_IMPLEMENTATION", "BACKEND_IMPLEMENTATION", "QA", "SPEC_REVIEW", "EXPERIENCE_REVIEW"]},
        "role": {"enum": ["product_manager", "interaction_designer", "frontend_engineer", "backend_engineer", "qa_engineer", "spec_reviewer", "experience_reviewer"]}
      }
    }
  ]
}
