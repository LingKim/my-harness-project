{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinamate.local/schemas/handoff/common.schema.json",
  "title": "ChinaMate handoff contract common definitions",
  "$defs": {
    "schemaVersion": {"const": "1.0"},
    "contractId": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "change": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "stage": {
      "enum": [
        "PRODUCT_SPEC",
        "INTERACTION_DESIGN",
        "FRONTEND_IMPLEMENTATION",
        "BACKEND_IMPLEMENTATION",
        "QA",
        "SPEC_REVIEW",
        "EXPERIENCE_REVIEW"
      ]
    },
    "controlPlaneStage": {"const": "CONTROL_PLANE_IMPLEMENTATION"},
    "role": {
      "enum": [
        "product_manager",
        "interaction_designer",
        "frontend_engineer",
        "backend_engineer",
        "qa_engineer",
        "spec_reviewer",
        "experience_reviewer"
      ]
    },
    "controlPlaneRole": {"const": "main_agent"},
    "controlPlaneExecutionMode": {"const": "CONTROL_PLANE"},
    "taskIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidenceRefs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "SATISFIED", "NOT_APPLICABLE"]},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceRefs"],
      "properties": {
        "status": {"enum": ["PENDING", "ACCEPTED", "REJECTED", "STALE"]},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "summary"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "PASS_WITH_ISSUES", "FAIL", "BLOCKED", "NOT_RUN"]},
        "summary": {"type": "string"}
      }
    }
  }
}
